[Unit]
Description=OpenBrain: shared project state for people and AI agents
After=network.target

[Service]
Type=simple
User=openbrain
Group=openbrain
EnvironmentFile=/etc/openbrain/env
ExecStart=/usr/local/bin/openbrain serve
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15s

# /var/lib/openbrain, created and owned by the service user.
StateDirectory=openbrain
StateDirectoryMode=0750
UMask=0077

# Resource controls: be a good neighbour to whatever else runs on the box.
# Measured (see docs/DEPLOYMENT.md): ~18 MB RSS idle, under 40 MB at peak
# including Argon2id sign-ins, zero CPU when idle. The cgroup figure also
# counts SQLite's page cache, which the kernel reclaims first at MemoryHigh.
Environment=GOMEMLIMIT=48MiB
# On hosts with transparent huge pages set to "always", the kernel inflates
# the small Go heap into 2 MB pages while idle. Huge pages only pay off for
# far larger heaps.
Environment=GODEBUG=disablethp=1
MemoryHigh=64M
MemoryMax=96M
MemorySwapMax=0
CPUWeight=50
CPUQuota=50%
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TasksMax=64

# Hardening. The service only needs its state directory and the network.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
