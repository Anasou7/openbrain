# OpenBrain configuration, read by systemd's EnvironmentFile=.
# Install as /etc/openbrain/env, owned root:openbrain, mode 0640:
#   install -m 0640 -o root -g openbrain openbrain.env.example /etc/openbrain/env
# Nothing here is a secret unless you set OPENBRAIN_TOKEN.

# Where the SQLite database lives. The directory must be writable by the
# service user (systemd's StateDirectory= creates /var/lib/openbrain).
OPENBRAIN_DB=/var/lib/openbrain/openbrain.db

# Listen address. Keep it on loopback and put a reverse proxy (with HTTPS),
# Tailscale Serve or an SSH tunnel in front; see docs/DEPLOYMENT.md.
OPENBRAIN_ADDR=127.0.0.1:8080

# URL prefix OpenBrain is served under. "/" serves at the root of its own
# host (https://brain.example.com/); "/openbrain" shares a host with other
# sites (https://example.com/openbrain/). The reverse proxy must forward
# that prefix unchanged.
OPENBRAIN_BASE_PATH=/

# Proxies whose X-Forwarded-For / X-Forwarded-Proto headers are believed, as
# comma-separated addresses or CIDR ranges. Used for sign-in rate limiting and
# secure cookies. The default trusts a proxy on the same machine.
#OPENBRAIN_TRUSTED_PROXIES=127.0.0.1,::1

# Optional administrative API token (32+ characters, e.g. openssl rand -hex 32)
# for REST scripts. It is powerful: it can register actors and write as any
# actor. People sign in with accounts and agents use their own actor tokens, so
# neither needs it, and /mcp refuses it. Leave unset unless a script needs it.
#OPENBRAIN_TOKEN=

# A working/waiting/blocked agent state that has not been refreshed for this
# long is flagged "stale".
#OPENBRAIN_STALE_AFTER=1h

#OPENBRAIN_LOG_FORMAT=json
#OPENBRAIN_LOG_LEVEL=info
