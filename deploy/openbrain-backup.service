[Unit]
Description=OpenBrain database backup
After=openbrain.service

[Service]
Type=oneshot
User=openbrain
Group=openbrain
EnvironmentFile=/etc/openbrain/env
# Writes <dir of OPENBRAIN_DB>/backups/openbrain-<UTC time>.db and verifies it.
ExecStart=/usr/local/bin/openbrain backup
# Keep two weeks of daily backups. Adjust the path if you changed OPENBRAIN_DB.
ExecStartPost=/usr/bin/find /var/lib/openbrain/backups -name "openbrain-*.db" -mtime +14 -delete
UMask=0077
Nice=19
IOSchedulingClass=idle

StateDirectory=openbrain
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
